## Haze Services Provider - Environment Configuration Template
## Copy this file to 'local.properties' and fill in your values.

# Location of the Android SDK
sdk.dir=C\:\\Users\\asus\\AppData\\Local\\Android\\Sdk

# Supabase Project Configuration
# Found in: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-actual-anon-public-key
